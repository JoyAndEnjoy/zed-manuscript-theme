{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "Manuscript Theme Decolorized Dark High Contrast",
    "author": "JoyAndEnjoy",
    "themes": [
        {
            "name": "Manuscript Theme Decolorized Dark High Contrast",
            "appearance": "dark",
            "style": {
                "border": "#D4CEC41A",
                "border.variant": "#D4CEC40D",
                "border.focused": "#D4CEC466",
                "border.selected": "#D4CEC44D",
                "border.transparent": "#00000000",
                "border.disabled": null,
                "elevated_surface.background": "#1C1714",
                "surface.background": "#1C1714",
                "background": "#1C1714",
                "element.background": "#1C1714",
                "element.hover": "#D4CEC40D",
                "element.active": "#D4CEC41A",
                "element.selected": "#D4CEC414",
                "element.disabled": "#1C1714",
                "drop_target.background": "#D4CEC425",
                "ghost_element.background": "#00000000",
                "ghost_element.hover": "#D4CEC40D",
                "ghost_element.active": "#D4CEC41A",
                "ghost_element.selected": "#D4CEC414",
                "ghost_element.disabled": null,

                "text": "#D4CEC4",
                "text.muted": "#8A7E73",
                "text.placeholder": "#6B6258",
                "text.disabled": "#4F4740",
                "text.accent": "#EADDCE",
                "icon": "#D4CEC4",
                "icon.muted": "#8A7E73",
                "icon.disabled": "#4F4740",
                "icon.placeholder": null,
                "icon.accent": "#EADDCE",

                "status_bar.background": "#1C1714",
                "title_bar.background": "#1C1714",
                "title_bar.inactive_background": "#2A241F",
                "toolbar.background": "#1C1714",
                "tab_bar.background": "#1C1714",
                "tab.inactive_background": "#1C1714",
                "tab.active_background": "#2A241F",

                "search.match_background": "#EADDCE20",
                "search.active_match_background": "#EADDCE33",
                "panel.background": "#1C1714",
                "panel.focused_border": "#EADDCE66",
                "pane.focused_border": "#EADDCE66",

                "scrollbar.thumb.background": "#EADDCE1A",
                "scrollbar.thumb.hover_background": "#EADDCE33",
                "scrollbar.thumb.active_background": "#EADDCE4D",
                "scrollbar.thumb.border": "#00000000",
                "scrollbar.track.background": "#00000000",
                "scrollbar.track.border": "#00000000",

                "editor.foreground": "#D4CEC4",
                "editor.background": "#2A241F",
                "editor.gutter.background": "#2A241F",
                "editor.subheader.background": "#1C1714",
                "editor.active_line.background": "#EADDCE0A",
                "editor.highlighted_line.background": "#EADDCE14",
                "editor.line_number": "#4F4740",
                "editor.active_line_number": "#EADDCE",
                "editor.hover_line_number": "#A0958A",
                "editor.invisible": "#3A332C",
                "editor.wrap_guide": "#EADDCE1A",
                "editor.active_wrap_guide": "#EADDCE40",
                "editor.document_highlight.read_background": "#EADDCE1A",
                "editor.document_highlight.write_background": "#EADDCE26",

                "terminal.background": "#2A241F",
                "terminal.foreground": "#D4CEC4",
                "terminal.bright_foreground": "#EADDCE",
                "terminal.dim_foreground": "#8A7E73",
                "terminal.ansi.black": "#1C1714",
                "terminal.ansi.bright_black": "#A0958A",
                "terminal.ansi.dim_black": "#8A7E73",
                "terminal.ansi.red": "#D4CEC4",
                "terminal.ansi.bright_red": "#EADDCE",
                "terminal.ansi.dim_red": "#8A7E73",
                "terminal.ansi.green": "#D4CEC4",
                "terminal.ansi.bright_green": "#EADDCE",
                "terminal.ansi.dim_green": "#8A7E73",
                "terminal.ansi.yellow": "#D4CEC4",
                "terminal.ansi.bright_yellow": "#EADDCE",
                "terminal.ansi.dim_yellow": "#8A7E73",
                "terminal.ansi.blue": "#D4CEC4",
                "terminal.ansi.bright_blue": "#EADDCE",
                "terminal.ansi.dim_blue": "#8A7E73",
                "terminal.ansi.magenta": "#D4CEC4",
                "terminal.ansi.bright_magenta": "#EADDCE",
                "terminal.ansi.dim_magenta": "#8A7E73",
                "terminal.ansi.cyan": "#D4CEC4",
                "terminal.ansi.bright_cyan": "#EADDCE",
                "terminal.ansi.dim_cyan": "#8A7E73",
                "terminal.ansi.white": "#4F4740",
                "terminal.ansi.bright_white": "#3A332C",
                "terminal.ansi.dim_white": "#6B6258",

                "link_text.hover": "#EADDCE",

                "version_control.added": "#8A7E73",
                "version_control.modified": "#6B6258",
                "version_control.deleted": "#A0958A",
                "version_control.word_added": "#EADDCE1A",
                "version_control.word_deleted": "#EADDCE26",

                "conflict": "#EADDCE",
                "created": "#A0958A",
                "created.background": "#EADDCE1A",
                "deleted": "#D4CEC4",
                "deleted.background": "#EADDCE26",
                "error": "#EADDCE",
                "error.background": "#EADDCE14",
                "error.border": "#EADDCE",
                "hidden": "#4F4740",
                "hint": "#6B6258",
                "hint.background": "#EADDCE0D",
                "hint.border": "#EADDCE33",
                "ignored": "#4F4740",
                "info": "#A0958A",
                "info.background": "#EADDCE0D",
                "info.border": "#EADDCE33",
                "modified": "#8A7E73",
                "predictive": "#4F4740",
                "success": "#A0958A",
                "success.background": "#EADDCE1A",
                "warning": "#D4CEC4",
                "warning.background": "#EADDCE14",
                "warning.border": "#D4CEC4",

                "players": [
                    { "cursor": "#EADDCE", "background": "#EADDCE", "selection": "#EADDCE26" },
                    { "cursor": "#D4CEC4", "background": "#D4CEC4", "selection": "#EADDCE1A" },
                    { "cursor": "#A0958A", "background": "#A0958A", "selection": "#EADDCE14" }
                ],
                "accents": ["#EADDCE", "#D4CEC4", "#A0958A", "#8A7E73"],

                "syntax": {
                    "keyword": { "color": "#EADDCE", "font_weight": 400 },
                    "type": { "color": "#EADDCE", "font_weight": 400 },
                    "type.builtin": { "color": "#D4CEC4", "font_weight": 400 },
                    "type.interface": { "color": "#D4CEC4", "font_weight": 400 },
                    "type.enum": { "color": "#D4CEC4", "font_weight": 400 },
                    "type.parameter": { "color": "#A0958A" },

                    "function": { "color": "#EADDCE", "font_weight": 400 },
                    "function.special": { "color": "#EADDCE", "font_weight": 400 },
                    "constructor": { "color": "#EADDCE", "font_style": "italic", "font_weight": 400 },

                    "variable": { "color": "#EADDCE" },
                    "variable.special": { "color": "#EADDCE", "font_style": "italic" },
                    "property": { "color": "#EADDCE" },
                    "attribute": { "color": "#EADDCE" },

                    "string": { "color": "#BAA367", "font_style": "italic", "font_weight": 400 },
                    "string.escape": { "color": "#D4CEC4", "font_weight": 400 },
                    "string.regex": { "color": "#A0958A" },
                    "string.special": { "color": "#D4CEC4" },
                    "text.literal": { "color": "#8A7E73" },

                    "number": { "color": "#D4CEC4" },
                    "boolean": { "color": "#EADDCE", "font_weight": 400 },
                    "constant": { "color": "#D4CEC4", "font_style": "italic" },

                    "comment": { "color": "#6B6258", "font_style": "italic" },
                    "comment.doc": { "color": "#8A7E73", "font_style": "italic" },

                    "punctuation": { "color": "#8A7E73" },
                    "punctuation.bracket": { "color": "#A0958A" },
                    "punctuation.delimiter": { "color": "#6B6258" },
                    "punctuation.special": { "color": "#D4CEC4" },

                    "operator": { "color": "#D4CEC4" },
                    "operator.controlFlow": { "color": "#EADDCE", "font_weight": 400 },

                    "namespace": { "color": "#8A7E73" },
                    "module": { "color": "#8A7E73" },

                    "tag": { "color": "#D4CEC4" },
                    "title": { "color": "#EADDCE", "font_weight": 400 },
                    "link_text": { "color": "#A0958A", "font_weight": 400 },
                    "link_uri": { "color": "#8A7E73", "font_style": "italic" },
                    "embedded": { "color": "#A0958A" },

                    "emphasis": { "color": "#EADDCE", "font_style": "italic" },
                    "emphasis.strong": { "color": "#EADDCE", "font_weight": 400 },
                    "hint": { "color": "#6B6258" },
                    "predictive": { "color": "#4F4740", "font_style": "italic" }
                }
            }
        }
    ]
}
