{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "Manuscript Theme Dark",
    "author": "JoyAndEnjoy",
    "themes": [
        {
            "name": "Manuscript Theme Dark",
            "appearance": "dark",
            "style": {
                "border": "#D4CEC41A",
                "border.variant": "#D4CEC40D",
                "border.focused": "#D4CEC466",
                "border.selected": "#D4CEC44D",
                "border.transparent": "#00000000",
                "border.disabled": null,
                "elevated_surface.background": "#1C1714",
                "surface.background": "#1C1714",
                "background": "#1C1714",
                "element.background": "#1C1714",
                "element.hover": "#D4CEC40D",
                "element.active": "#D4CEC41A",
                "element.selected": "#D4CEC414",
                "element.disabled": "#1C1714",
                "drop_target.background": "#D4CEC425",
                "ghost_element.background": "#00000000",
                "ghost_element.hover": "#D4CEC40D",
                "ghost_element.active": "#D4CEC41A",
                "ghost_element.selected": "#D4CEC414",
                "ghost_element.disabled": null,

                "text": "#D4CEC4",
                "text.muted": "#8A7E73",
                "text.placeholder": "#6B6258",
                "text.disabled": "#4F4740",
                "text.accent": "#EADDCE",
                "icon": "#D4CEC4",
                "icon.muted": "#8A7E73",
                "icon.disabled": "#4F4740",
                "icon.placeholder": null,
                "icon.accent": "#EADDCE",

                "status_bar.background": "#1C1714",
                "title_bar.background": "#1C1714",
                "title_bar.inactive_background": "#2A241F",
                "toolbar.background": "#1C1714",
                "tab_bar.background": "#1C1714",
                "tab.inactive_background": "#1C1714",
                "tab.active_background": "#2A241F",

                "search.match_background": "#D4CEC420",
                "search.active_match_background": "#D4CEC433",
                "panel.background": "#1C1714",
                "panel.focused_border": "#D4CEC466",
                "pane.focused_border": "#D4CEC466",

                "scrollbar.thumb.background": "#D4CEC41A",
                "scrollbar.thumb.hover_background": "#D4CEC433",
                "scrollbar.thumb.active_background": "#D4CEC44D",
                "scrollbar.thumb.border": "#00000000",
                "scrollbar.track.background": "#00000000",
                "scrollbar.track.border": "#00000000",

                "editor.foreground": "#D4CEC4",
                "editor.background": "#2A241F",
                "editor.gutter.background": "#2A241F",
                "editor.subheader.background": "#1C1714",
                "editor.active_line.background": "#D4CEC40A",
                "editor.highlighted_line.background": "#D4CEC414",
                "editor.line_number": "#6B6258",
                "editor.active_line_number": "#D4CEC4",
                "editor.hover_line_number": "#8A7E73",
                "editor.invisible": "#4F4740",
                "editor.wrap_guide": "#D4CEC40A",
                "editor.active_wrap_guide": "#D4CEC426",
                "editor.document_highlight.read_background": "#D4CEC41A",
                "editor.document_highlight.write_background": "#D4CEC426",

                "terminal.background": "#2A241F",
                "terminal.foreground": "#D4CEC4",
                "terminal.bright_foreground": "#EADDCE",
                "terminal.dim_foreground": "#8A7E73",
                "terminal.ansi.black": "#1C1714",
                "terminal.ansi.bright_black": "#4F4740",
                "terminal.ansi.dim_black": "#3A332C",
                "terminal.ansi.red": "#C87D71",
                "terminal.ansi.bright_red": "#E09488",
                "terminal.ansi.dim_red": "#A35C52",
                "terminal.ansi.green": "#9DA384",
                "terminal.ansi.bright_green": "#B8C09B",
                "terminal.ansi.dim_green": "#7A8062",
                "terminal.ansi.yellow": "#BAA367",
                "terminal.ansi.bright_yellow": "#D4BE7F",
                "terminal.ansi.dim_yellow": "#917E4C",
                "terminal.ansi.blue": "#7DA1B5",
                "terminal.ansi.bright_blue": "#9AC0D6",
                "terminal.ansi.dim_blue": "#5D7C8F",
                "terminal.ansi.magenta": "#A885B3",
                "terminal.ansi.bright_magenta": "#C5A1D1",
                "terminal.ansi.dim_magenta": "#85648F",
                "terminal.ansi.cyan": "#76A8A1",
                "terminal.ansi.bright_cyan": "#91C4BC",
                "terminal.ansi.dim_cyan": "#5A857F",
                "terminal.ansi.white": "#D4CEC4",
                "terminal.ansi.bright_white": "#EADDCE",
                "terminal.ansi.dim_white": "#8A7E73",

                "link_text.hover": "#EADDCE",

                "version_control.added": "#9DA384",
                "version_control.modified": "#7DA1B5",
                "version_control.deleted": "#C87D71",
                "version_control.word_added": "#9DA38433",
                "version_control.word_deleted": "#C87D7133",

                "conflict": "#BAA367",
                "created": "#9DA384",
                "created.background": "#9DA3841A",
                "deleted": "#C87D71",
                "deleted.background": "#C87D711A",
                "error": "#C87D71",
                "error.background": "#C87D7114",
                "error.border": "#C87D71",
                "hidden": "#4F4740",
                "hint": "#8A7E73",
                "hint.background": "#D4CEC40D",
                "hint.border": "#D4CEC433",
                "ignored": "#6B6258",
                "info": "#7DA1B5",
                "info.background": "#D4CEC40D",
                "info.border": "#D4CEC433",
                "modified": "#7DA1B5",
                "predictive": "#6B6258",
                "success": "#9DA384",
                "success.background": "#9DA3841A",
                "warning": "#BAA367",
                "warning.background": "#BAA36714",
                "warning.border": "#BAA367",

                "players": [
                    { "cursor": "#EADDCE", "background": "#EADDCE", "selection": "#D4CEC426" },
                    { "cursor": "#C87D71", "background": "#C87D71", "selection": "#D4CEC41A" },
                    { "cursor": "#7DA1B5", "background": "#7DA1B5", "selection": "#D4CEC414" }
                ],
                "accents": ["#C87D71", "#7DA1B5", "#BAA367", "#9DA384"],

                "syntax": {
                    "keyword": { "color": "#C87D71", "font_weight": 400 },
                    "type": { "color": "#D4CEC4", "font_weight": 400 },
                    "type.builtin": { "color": "#EADDCE", "font_weight": 400 },
                    "type.interface": { "color": "#EADDCE", "font_weight": 400 },
                    "type.enum": { "color": "#EADDCE", "font_weight": 400 },
                    "type.parameter": { "color": "#A0958A" },

                    "function": { "color": "#7DA1B5", "font_weight": 400 },
                    "function.special": { "color": "#A885B3", "font_weight": 400 },
                    "constructor": { "color": "#D4CEC4", "font_style": "italic", "font_weight": 400 },

                    "variable": { "color": "#D4CEC4" },
                    "variable.special": { "color": "#D4CEC4", "font_style": "italic" },
                    "property": { "color": "#D4CEC4" },
                    "attribute": { "color": "#D4CEC4" },

                    "string": { "color": "#BAA367", "font_style": "italic", "font_weight": 400 },
                    "string.escape": { "color": "#EADDCE", "font_weight": 400 },
                    "string.regex": { "color": "#A0958A" },
                    "string.special": { "color": "#EADDCE" },
                    "text.literal": { "color": "#A0958A" },

                    "number": { "color": "#9DA384" },
                    "boolean": { "color": "#C87D71", "font_weight": 400 },
                    "constant": { "color": "#EADDCE", "font_style": "italic" },

                    "comment": { "color": "#8A7E73", "font_style": "italic" },
                    "comment.doc": { "color": "#766A5F", "font_style": "italic" },

                    "punctuation": { "color": "#8A7E73" },
                    "punctuation.bracket": { "color": "#8A7E73" },
                    "punctuation.delimiter": { "color": "#6B6258" },
                    "punctuation.special": { "color": "#A0958A" },

                    "operator": { "color": "#A0958A" },
                    "operator.controlFlow": { "color": "#C87D71", "font_weight": 400 },

                    "namespace": { "color": "#8A7E73" },
                    "module": { "color": "#8A7E73" },

                    "tag": { "color": "#C87D71" },
                    "title": { "color": "#EADDCE", "font_weight": 400 },
                    "link_text": { "color": "#A0958A", "font_weight": 400 },
                    "link_uri": { "color": "#766A5F", "font_style": "italic" },
                    "embedded": { "color": "#A0958A" },

                    "emphasis": { "color": "#D4CEC4", "font_style": "italic" },
                    "emphasis.strong": { "color": "#D4CEC4", "font_weight": 700 },
                    "hint": { "color": "#6B6258" },
                    "predictive": { "color": "#4F4740", "font_style": "italic" }
                }
            }
        }
    ]
}
