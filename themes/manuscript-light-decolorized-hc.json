{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "Manuscript Theme Decolorized High Contrast",
    "author": "JoyAndEnjoy",
    "themes": [
        {
            "name": "Manuscript Theme Decolorized High Contrast",
            "appearance": "light",
            "style": {
                "border": "#1A1A1A1A",
                "border.variant": "#1A1A1A15",
                "border.focused": "#1A1A1A66",
                "border.selected": "#1A1A1A4D",
                "border.transparent": "#00000000",
                "border.disabled": null,
                "elevated_surface.background": "#fbeecb",
                "surface.background": "#fbeecb",
                "background": "#fbeecb",
                "element.background": "#fbeecb",
                "element.hover": "#1A1A1A0D",
                "element.active": "#1A1A1A1A",
                "element.selected": "#1A1A1A14",
                "element.disabled": "#fbeecb",
                "drop_target.background": "#1A1A1A25",
                "ghost_element.background": "#00000000",
                "ghost_element.hover": "#1A1A1A0D",
                "ghost_element.active": "#1A1A1A1A",
                "ghost_element.selected": "#1A1A1A14",
                "ghost_element.disabled": null,

                "text": "#333333",
                "text.muted": "#808080",
                "text.placeholder": "#999999",
                "text.disabled": "#B3B3B3",
                "text.accent": "#1A1A1A",
                "icon": "#333333",
                "icon.muted": "#808080",
                "icon.disabled": "#B3B3B3",
                "icon.placeholder": null,
                "icon.accent": "#1A1A1A",

                "status_bar.background": "#fbeecb",
                "title_bar.background": "#fbeecb",
                "title_bar.inactive_background": "#fdf6e3",
                "toolbar.background": "#fbeecb",
                "tab_bar.background": "#fbeecb",
                "tab.inactive_background": "#fbeecb",
                "tab.active_background": "#fdf6e3",

                "search.match_background": "#1A1A1A20",
                "search.active_match_background": "#1A1A1A33",
                "panel.background": "#fbeecb",
                "panel.focused_border": "#1A1A1A66",
                "pane.focused_border": "#1A1A1A66",

                "scrollbar.thumb.background": "#1A1A1A1A",
                "scrollbar.thumb.hover_background": "#1A1A1A33",
                "scrollbar.thumb.active_background": "#1A1A1A4D",
                "scrollbar.thumb.border": "#00000000",
                "scrollbar.track.background": "#00000000",
                "scrollbar.track.border": "#00000000",

                "editor.foreground": "#333333",
                "editor.background": "#fdf6e3",
                "editor.gutter.background": "#fdf6e3",
                "editor.subheader.background": "#fbeecb",
                "editor.active_line.background": "#1A1A1A0A",
                "editor.highlighted_line.background": "#1A1A1A14",
                "editor.line_number": "#B3B3B3",
                "editor.active_line_number": "#1A1A1A",
                "editor.hover_line_number": "#4D4D4D",
                "editor.invisible": "#E0E0E0",
                "editor.wrap_guide": "#1A1A1A1A",
                "editor.active_wrap_guide": "#1A1A1A40",
                "editor.document_highlight.read_background": "#1A1A1A1A",
                "editor.document_highlight.write_background": "#1A1A1A26",

                "terminal.background": "#fdf6e3",
                "terminal.foreground": "#333333",
                "terminal.bright_foreground": "#1A1A1A",
                "terminal.dim_foreground": "#808080",
                "terminal.ansi.black": "#1A1A1A",
                "terminal.ansi.bright_black": "#4D4D4D",
                "terminal.ansi.dim_black": "#808080",
                "terminal.ansi.red": "#333333",
                "terminal.ansi.bright_red": "#1A1A1A",
                "terminal.ansi.dim_red": "#666666",
                "terminal.ansi.green": "#333333",
                "terminal.ansi.bright_green": "#1A1A1A",
                "terminal.ansi.dim_green": "#666666",
                "terminal.ansi.yellow": "#333333",
                "terminal.ansi.bright_yellow": "#1A1A1A",
                "terminal.ansi.dim_yellow": "#666666",
                "terminal.ansi.blue": "#333333",
                "terminal.ansi.bright_blue": "#1A1A1A",
                "terminal.ansi.dim_blue": "#666666",
                "terminal.ansi.magenta": "#333333",
                "terminal.ansi.bright_magenta": "#1A1A1A",
                "terminal.ansi.dim_magenta": "#666666",
                "terminal.ansi.cyan": "#333333",
                "terminal.ansi.bright_cyan": "#1A1A1A",
                "terminal.ansi.dim_cyan": "#666666",
                "terminal.ansi.white": "#B3B3B3",
                "terminal.ansi.bright_white": "#CCCCCC",
                "terminal.ansi.dim_white": "#999999",

                "link_text.hover": "#1A1A1A",

                "version_control.added": "#666666",
                "version_control.modified": "#808080",
                "version_control.deleted": "#4D4D4D",
                "version_control.word_added": "#1A1A1A1A",
                "version_control.word_deleted": "#1A1A1A26",

                "conflict": "#1A1A1A",
                "created": "#4D4D4D",
                "created.background": "#1A1A1A1A",
                "deleted": "#333333",
                "deleted.background": "#1A1A1A26",
                "error": "#1A1A1A",
                "error.background": "#1A1A1A14",
                "error.border": "#1A1A1A",
                "hidden": "#B3B3B3",
                "hint": "#808080",
                "hint.background": "#1A1A1A0D",
                "hint.border": "#1A1A1A33",
                "ignored": "#999999",
                "info": "#4D4D4D",
                "info.background": "#1A1A1A0D",
                "info.border": "#1A1A1A33",
                "modified": "#666666",
                "predictive": "#999999",
                "success": "#4D4D4D",
                "success.background": "#1A1A1A1A",
                "warning": "#333333",
                "warning.background": "#1A1A1A14",
                "warning.border": "#333333",

                "players": [
                    { "cursor": "#1A1A1A", "background": "#1A1A1A", "selection": "#1A1A1A26" },
                    { "cursor": "#333333", "background": "#333333", "selection": "#1A1A1A1A" },
                    { "cursor": "#4D4D4D", "background": "#4D4D4D", "selection": "#1A1A1A14" }
                ],
                "accents": ["#1A1A1A", "#333333", "#4D4D4D", "#666666"],

                "syntax": {
                    "keyword": { "color": "#1A1A1A", "font_weight": 400 },
                    "type": { "color": "#1A1A1A", "font_weight": 400 },
                    "type.builtin": { "color": "#333333", "font_weight": 400 },
                    "type.interface": { "color": "#333333", "font_weight": 400 },
                    "type.enum": { "color": "#333333", "font_weight": 400 },
                    "type.parameter": { "color": "#4D4D4D" },

                    "function": { "color": "#1A1A1A", "font_weight": 400 },
                    "function.special": { "color": "#1A1A1A", "font_weight": 400 },
                    "constructor": { "color": "#1A1A1A", "font_style": "italic", "font_weight": 400 },

                    "variable": { "color": "#1A1A1A" },
                    "variable.special": { "color": "#1A1A1A", "font_style": "italic" },
                    "property": { "color": "#1A1A1A" },
                    "attribute": { "color": "#1A1A1A" },

                    "string": { "color": "#be962a", "font_style": "italic", "font_weight": 400 },
                    "string.escape": { "color": "#333333", "font_weight": 400 },
                    "string.regex": { "color": "#4D4D4D" },
                    "string.special": { "color": "#333333" },
                    "text.literal": { "color": "#666666" },

                    "number": { "color": "#333333" },
                    "boolean": { "color": "#1A1A1A", "font_weight": 400 },
                    "constant": { "color": "#333333", "font_style": "italic" },

                    "comment": { "color": "#999999", "font_style": "italic" },
                    "comment.doc": { "color": "#808080", "font_style": "italic" },

                    "punctuation": { "color": "#808080" },
                    "punctuation.bracket": { "color": "#666666" },
                    "punctuation.delimiter": { "color": "#999999" },
                    "punctuation.special": { "color": "#4D4D4D" },

                    "operator": { "color": "#333333" },
                    "operator.controlFlow": { "color": "#1A1A1A", "font_weight": 400 },

                    "namespace": { "color": "#666666" },
                    "module": { "color": "#666666" },

                    "tag": { "color": "#333333" },
                    "title": { "color": "#1A1A1A", "font_weight": 400 },
                    "link_text": { "color": "#4D4D4D", "font_weight": 400 },
                    "link_uri": { "color": "#808080", "font_style": "italic" },
                    "embedded": { "color": "#4D4D4D" },

                    "emphasis": { "color": "#1A1A1A", "font_style": "italic" },
                    "emphasis.strong": { "color": "#1A1A1A", "font_weight": 400 },
                    "hint": { "color": "#999999" },
                    "predictive": { "color": "#B3B3B3", "font_style": "italic" }
                }
            }
        }
    ]
}
