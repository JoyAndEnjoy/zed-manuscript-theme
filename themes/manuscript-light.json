{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "Manuscript Theme Light",
    "author": "JoyAndEnjoy",
    "themes": [
        {
            "name": "Manuscript Theme Light",
            "appearance": "light",
            "style": {
                "border": "#3A332C1A",
                "border.variant": "#3A332C15",
                "border.focused": "#3A332C66",
                "border.selected": "#3A332C4D",
                "border.transparent": "#00000000",
                "border.disabled": null,
                "elevated_surface.background": "#fbeecb",
                "surface.background": "#fbeecb",
                "background": "#fbeecb",
                "element.background": "#fbeecb",
                "element.hover": "#3A332C0D",
                "element.active": "#3A332C1A",
                "element.selected": "#3A332C14",
                "element.disabled": "#fbeecb",
                "drop_target.background": "#3A332C25",
                "ghost_element.background": "#00000000",
                "ghost_element.hover": "#3A332C0D",
                "ghost_element.active": "#3A332C1A",
                "ghost_element.selected": "#3A332C14",
                "ghost_element.disabled": null,

                "text": "#3A332C",
                "text.muted": "#8A7E73",
                "text.placeholder": "#A0958A",
                "text.disabled": "#B8B2A7",
                "text.accent": "#A65245",
                "icon": "#3A332C",
                "icon.muted": "#8A7E73",
                "icon.disabled": "#B8B2A7",
                "icon.placeholder": null,
                "icon.accent": "#A65245",

                "status_bar.background": "#fbeecb",
                "title_bar.background": "#fbeecb",
                "title_bar.inactive_background": "#fdf6e3",
                "toolbar.background": "#fbeecb",
                "tab_bar.background": "#fbeecb",
                "tab.inactive_background": "#fbeecb",
                "tab.active_background": "#fdf6e3",

                "search.match_background": "#A6524533",
                "search.active_match_background": "#A652454D",
                "panel.background": "#fbeecb",
                "panel.focused_border": "#3A332C66",
                "pane.focused_border": "#3A332C66",

                "scrollbar.thumb.background": "#3A332C1A",
                "scrollbar.thumb.hover_background": "#3A332C33",
                "scrollbar.thumb.active_background": "#3A332C4D",
                "scrollbar.thumb.border": "#00000000",
                "scrollbar.track.background": "#00000000",
                "scrollbar.track.border": "#00000000",

                "editor.foreground": "#3A332C",
                "editor.background": "#fdf6e3",
                "editor.gutter.background": "#fdf6e3",
                "editor.subheader.background": "#fbeecb",
                "editor.active_line.background": "#3A332C0A",
                "editor.highlighted_line.background": "#3A332C14",
                "editor.line_number": "#A0958A",
                "editor.active_line_number": "#3A332C",
                "editor.hover_line_number": "#6B6258",
                "editor.invisible": "#D4CEC4",
                "editor.wrap_guide": "#3A332C1A",
                "editor.active_wrap_guide": "#3A332C40",
                "editor.document_highlight.read_background": "#3A332C1A",
                "editor.document_highlight.write_background": "#3A332C26",

                "terminal.background": "#fdf6e3",
                "terminal.foreground": "#3A332C",
                "terminal.bright_foreground": "#1C1714",
                "terminal.dim_foreground": "#8A7E73",
                "terminal.ansi.black": "#1C1714",
                "terminal.ansi.bright_black": "#4F4740",
                "terminal.ansi.dim_black": "#8A7E73",
                "terminal.ansi.red": "#A65245",
                "terminal.ansi.bright_red": "#8C3C30",
                "terminal.ansi.dim_red": "#C87D71",
                "terminal.ansi.green": "#627344",
                "terminal.ansi.bright_green": "#495730",
                "terminal.ansi.dim_green": "#9DA384",
                "terminal.ansi.yellow": "#8A6F32",
                "terminal.ansi.bright_yellow": "#665120",
                "terminal.ansi.dim_yellow": "#BAA367",
                "terminal.ansi.blue": "#4A768F",
                "terminal.ansi.bright_blue": "#32576E",
                "terminal.ansi.dim_blue": "#7DA1B5",
                "terminal.ansi.magenta": "#815C8F",
                "terminal.ansi.bright_magenta": "#624070",
                "terminal.ansi.dim_magenta": "#A885B3",
                "terminal.ansi.cyan": "#4A8580",
                "terminal.ansi.bright_cyan": "#30635F",
                "terminal.ansi.dim_cyan": "#76A8A1",
                "terminal.ansi.white": "#A0958A",
                "terminal.ansi.bright_white": "#D4CEC4",
                "terminal.ansi.dim_white": "#8A7E73",

                "link_text.hover": "#A65245",

                "version_control.added": "#627344",
                "version_control.modified": "#4A768F",
                "version_control.deleted": "#A65245",
                "version_control.word_added": "#62734433",
                "version_control.word_deleted": "#A6524533",

                "conflict": "#8A6F32",
                "created": "#627344",
                "created.background": "#6273441A",
                "deleted": "#A65245",
                "deleted.background": "#A652451A",
                "error": "#A65245",
                "error.background": "#A6524514",
                "error.border": "#A65245",
                "hidden": "#B8B2A7",
                "hint": "#8A7E73",
                "hint.background": "#3A332C0D",
                "hint.border": "#3A332C33",
                "ignored": "#A0958A",
                "info": "#4A768F",
                "info.background": "#3A332C0D",
                "info.border": "#3A332C33",
                "modified": "#4A768F",
                "predictive": "#A0958A",
                "success": "#627344",
                "success.background": "#6273441A",
                "warning": "#8A6F32",
                "warning.background": "#8A6F3214",
                "warning.border": "#8A6F32",

                "players": [
                    { "cursor": "#3A332C", "background": "#3A332C", "selection": "#3A332C26" },
                    { "cursor": "#A65245", "background": "#A65245", "selection": "#3A332C1A" },
                    { "cursor": "#4A768F", "background": "#4A768F", "selection": "#3A332C14" }
                ],
                "accents": ["#A65245", "#4A768F", "#8A6F32", "#627344"],

                "syntax": {
                    "keyword": { "color": "#A65245", "font_weight": 400 },
                    "type": { "color": "#3A332C", "font_weight": 400 },
                    "type.builtin": { "color": "#4F4740", "font_weight": 400 },
                    "type.interface": { "color": "#4F4740", "font_weight": 400 },
                    "type.enum": { "color": "#4F4740", "font_weight": 400 },
                    "type.parameter": { "color": "#6B6258" },

                    "function": { "color": "#4A768F", "font_weight": 400 },
                    "function.special": { "color": "#815C8F", "font_weight": 400 },
                    "constructor": { "color": "#3A332C", "font_style": "italic", "font_weight": 400 },

                    "variable": { "color": "#4F4740" },
                    "variable.special": { "color": "#4F4740", "font_style": "italic" },
                    "property": { "color": "#4F4740" },
                    "attribute": { "color": "#4F4740" },

                    "string": { "color": "#8A6F32", "font_style": "italic", "font_weight": 400 },
                    "string.escape": { "color": "#A65245", "font_weight": 400 },
                    "string.regex": { "color": "#6B6258" },
                    "string.special": { "color": "#A65245" },
                    "text.literal": { "color": "#6B6258" },

                    "number": { "color": "#627344" },
                    "boolean": { "color": "#A65245", "font_weight": 400 },
                    "constant": { "color": "#4F4740", "font_style": "italic" },

                    "comment": { "color": "#8A7E73", "font_style": "italic" },
                    "comment.doc": { "color": "#A0958A", "font_style": "italic" },

                    "punctuation": { "color": "#8A7E73" },
                    "punctuation.bracket": { "color": "#6B6258" },
                    "punctuation.delimiter": { "color": "#A0958A" },
                    "punctuation.special": { "color": "#6B6258" },

                    "operator": { "color": "#6B6258" },
                    "operator.controlFlow": { "color": "#A65245", "font_weight": 400 },

                    "namespace": { "color": "#8A7E73" },
                    "module": { "color": "#8A7E73" },

                    "tag": { "color": "#A65245" },
                    "title": { "color": "#3A332C", "font_weight": 400 },
                    "link_text": { "color": "#6B6258", "font_weight": 400 },
                    "link_uri": { "color": "#A0958A", "font_style": "italic" },
                    "embedded": { "color": "#6B6258" },

                    "emphasis": { "color": "#3A332C", "font_style": "italic" },
                    "emphasis.strong": { "color": "#3A332C", "font_weight": 700 },
                    "hint": { "color": "#A0958A" },
                    "predictive": { "color": "#B8B2A7", "font_style": "italic" }
                }
            }
        }
    ]
}
